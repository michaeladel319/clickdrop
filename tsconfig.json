{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "react": ["./frontend/node_modules/@types/react"],
      "react/*": ["./frontend/node_modules/@types/react/*"],
      "react/jsx-runtime": ["./frontend/node_modules/@types/react/jsx-runtime"]
    },
    "typeRoots": ["./frontend/node_modules/@types"]
  },
  "include": [
    ".agents/**/*"
  ]
}
